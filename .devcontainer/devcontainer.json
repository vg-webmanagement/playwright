{
  "name": "Node.js & Playwright",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:18",
  "features": {
    "ghcr.io/devcontainers-contrib/features/playwright:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-playwright.playwright",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "forwardPorts": [3000, 3001, 3002],
  "portsAttributes": {
    "3000": {
      "label": "QA Dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "cd playwright && npm install",
  "postStartCommand": "cd playwright && nohup node server.js > server.log 2>&1 & echo 'Server started on port 3000'",
  "postAttachCommand": "echo 'QA Dashboard available at http://localhost:3000'"
} 